# Do not edit: this file is generated by `ghat generate`.
name: PR Target
on:
  pull_request_target:
    types:
    - opened
jobs:
  check:
    name: Check
    runs-on: ubuntu-latest
    if: ${{ github.event.pull_request.head.ref != '' }}
    steps:
    - id: step_0
      run: echo target
      env:
        HEAD_REF: ${{ github.event.pull_request.head.ref }}
        BASE_REF: ${{ github.event.pull_request.base.ref }}
