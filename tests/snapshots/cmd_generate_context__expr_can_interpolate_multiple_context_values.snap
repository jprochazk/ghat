# Do not edit: this file is generated by `ghat generate`.
name: CI
on:
  push:
    branches:
    - main
jobs:
  build:
    name: Build
    runs-on: ubuntu-latest
    outputs:
      changed: 'true'
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    needs:
    - build
    if: ${{ github.ref == 'refs/heads/main' && needs.build.outputs.changed == 'true' }}
    steps:
    - id: step_0
      run: echo deploy
