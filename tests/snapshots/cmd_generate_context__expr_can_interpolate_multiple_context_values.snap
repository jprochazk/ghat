--- .github/ghat/workflows/ci.ts ---
workflow("CI", {
  on: triggers({ push: ["main"] }),
  jobs(ctx) {
    const build = ctx.job("Build", {
      runs_on: "ubuntu-latest",
      steps() {
        return { changed: "true" }
      }
    })

    ctx.job("Deploy", {
      runs_on: "ubuntu-latest",
      needs: [build],
      if: (ctx) => expr`${ctx.github.ref} == 'refs/heads/main' && ${ctx.needs.build.outputs.changed} == 'true'`,
      steps() { run("echo deploy") }
    })
  }
})
