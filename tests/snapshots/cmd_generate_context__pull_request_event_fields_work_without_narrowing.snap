# Do not edit: this file is generated by `ghat generate`.
name: PR
on:
  pull_request:
    types:
    - opened
    - synchronize
jobs:
  check:
    name: Check
    runs-on: ubuntu-latest
    if: ${{ github.event.pull_request.head.ref == 'main' }}
    steps:
    - id: step_0
      run: echo checking
      env:
        PR_REF: ${{ github.event.pull_request.head.ref }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
