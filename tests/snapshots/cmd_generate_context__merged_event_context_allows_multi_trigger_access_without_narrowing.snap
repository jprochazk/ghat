# Do not edit: this file is generated by `ghat generate`.
name: Mixed
on:
  pull_request:
    types:
    - opened
  issue_comment:
    types:
    - created
jobs:
  check:
    name: Check
    runs-on: ubuntu-latest
    if: ${{ github.event.pull_request.head.ref != '' && github.event.comment.body != '' }}
    steps:
    - id: step_0
      run: echo mixed
      env:
        PR_REF: ${{ github.event.pull_request.head.ref }}
        COMMENT_BODY: ${{ github.event.comment.body }}
